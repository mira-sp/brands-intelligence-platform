# Copy to infrastructure/docker/.env (git-ignored) before running docker-compose.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
SECRET_KEY=change-me-at-least-32-characters-long
# First admin account (created by `make db-init`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars
# Optional service-to-service key (X-API-Key header)
API_KEY=
# Public URLs (production)
CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
# IP of your reverse proxy as seen from the backend container (prod only)
FORWARDED_ALLOW_IPS=172.17.0.1
