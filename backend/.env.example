# .env.example - Template for environment variables
# Copy this to .env and fill in your actual values

# Application Settings
DEBUG=false
SQL_ECHO=false
# JWT signing key - required when DEBUG=false, min 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional service-to-service key (X-API-Key header) - grants the admin role
API_KEY=
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
# First admin user, created by init_db (make db-init) when no users exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local dev only: skip auth entirely (ignored unless DEBUG=true)
AUTH_DISABLED=false
# Rate limits (requests/minute per client IP)
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_ML_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/brand_intelligence
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200
CLICKHOUSE_URL=http://localhost:8123

# Application Info
APP_NAME="Brand Intelligence Platform"
VERSION="1.0.0"

# API Keys (Get your own from respective services)
NEWS_API_KEY=your_news_api_key_here
GOOGLENEWS_QUERY=https://news.google.com/rss/search?q=YOUR_QUERY

# ML Model Paths
SENTIMENT_MODEL_PATH=./ml/models/sentiment_model
CRISIS_MODEL_PATH=./ml/models/crisis_model
# AI visibility monitor
ANTHROPIC_API_KEY=
VISIBILITY_MODEL=claude-opus-5-5
# claude-haiku-5-5 is far cheaper for the judge - check that quality holds
VISIBILITY_JUDGE_MODEL=claude-opus-5-5
VISIBILITY_WEB_SEARCH=true
VISIBILITY_MAX_PROMPTS=50
